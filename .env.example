# Public site URL (used in emails, sitemap, receipts)
NEXT_PUBLIC_SITE_URL=https://nedivut.org

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Dashboard -> Account & Settings -> API keys / Webhooks)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email via Resend (optional; emails are skipped when unset)
RESEND_API_KEY=
EMAIL_FROM="Nedivut Charitable Trust <no-reply@nedivut.org>"
TEAM_NOTIFY_EMAIL=

# Random secrets (e.g. `openssl rand -hex 32`)
FORM_SIGNING_SECRET=
RATE_LIMIT_SALT=
